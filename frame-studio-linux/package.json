{
  "name": "frame-studio",
  "version": "2.4.21",
  "private": true,
  "description": "Video editor with bundled FFmpeg and yt-dlp, text preview editing, and shortcut tooltips",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node tests/smoke.js && node tests/customization.test.js && node tests/editor-interactions.test.js && node tests/audio-tools.test.js && node tests/timeline-regressions.test.js && node tests/group-mask.test.js && node tests/time-remap.test.js && node tests/export-integration.js && node tests/auto-update.test.js && node tests/2.4.16-animation-effects.test.js && node tests/2.4.16-advanced-effects.test.js && node tests/2.4.17-performance-export.test.js && node tests/2.4.18-live-preview-downloader.test.js && node tests/2.4.19-downloaded-media.test.js && node tests/2.4.20-bundled-tools-text-shortcuts.test.js && node tests/2.4.21-bundled-tools-autoprepare.test.js",
    "build:win": "electron-builder --win nsis portable --publish never",
    "build:linux": "electron-builder --linux AppImage deb rpm --publish never",
    "build": "electron-builder",
    "build:win:installer": "electron-builder --win nsis --x64 --publish never",
    "build:win:portable": "electron-builder --win portable --x64 --publish never",
    "build:linux:appimage": "electron-builder --linux AppImage --x64 --publish never",
    "prepare:tools": "node scripts/prepare-bundled-tools.cjs",
    "prestart": "node scripts/prepare-bundled-tools.cjs --quiet --allow-missing",
    "prebuild": "node scripts/prepare-bundled-tools.cjs --quiet",
    "prebuild:win": "node scripts/prepare-bundled-tools.cjs --quiet",
    "prebuild:win:installer": "node scripts/prepare-bundled-tools.cjs --quiet",
    "prebuild:win:portable": "node scripts/prepare-bundled-tools.cjs --quiet",
    "prebuild:linux": "node scripts/prepare-bundled-tools.cjs --quiet",
    "prebuild:linux:appimage": "node scripts/prepare-bundled-tools.cjs --quiet"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.frame.studio",
    "productName": "FRAME Studio",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "media-export.cjs",
      "index.html",
      "customization.js",
      "package.json",
      "gif-decoder.js"
    ],
    "artifactName": "FRAME-Studio-${version}-${platform}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "vendor/win",
          "to": "downloader",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "THIRD_PARTY_NOTICES.md",
          "to": "licenses/THIRD_PARTY_NOTICES.md"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "FRAME-Studio-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "FRAME-Studio-${version}-Portable-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "artifactName": "FRAME-Studio-${version}-${arch}.${ext}",
      "maintainer": "Gabrielly <gabrielly2303sr-sys@users.noreply.github.com>",
      "extraResources": [
        {
          "from": "vendor/linux",
          "to": "downloader",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "THIRD_PARTY_NOTICES.md",
          "to": "licenses/THIRD_PARTY_NOTICES.md"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gabrielly2303sr-sys",
        "repo": "FRAME-Studio-Releases",
        "releaseType": "release"
      }
    ],
    "deb": {
      "maintainer": "Gabrielly <gabrielly2303sr-sys@users.noreply.github.com>"
    },
    "rpm": {
      "maintainer": "Gabrielly <gabrielly2303sr-sys@users.noreply.github.com>"
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "homepage": "https://github.com/gabrielly2303sr-sys/FRAME-Studio-Releases",
  "author": {
    "name": "Gabrielly",
    "email": "gabrielly2303sr-sys@users.noreply.github.com"
  }
}
