# FRAME Studio OBJ test cube with per-face UV coordinates
# Import this file in Laboratorio 3D; choose FRAME-OBJ-Test-Texture.png manually.
v -1 -1 -1
v  1 -1 -1
v  1  1 -1
v -1  1 -1
v -1 -1  1
v  1 -1  1
v  1  1  1
v -1  1  1
vt 0 0
vt 1 0
vt 1 1
vt 0 1
# front
f 5/1 6/2 7/3 8/4
# back
f 2/1 1/2 4/3 3/4
# left
f 1/1 5/2 8/3 4/4
# right
f 6/1 2/2 3/3 7/4
# top
f 4/1 8/2 7/3 3/4
# bottom
f 1/1 2/2 6/3 5/4
